#!/usr/bin/env python3
# Interactive fake "claude": raw tty, bracketed paste on. On Enter (CR outside a paste) it logs the submitted
# text to $FAKE_LOG (repr) and shows a "working" screen for $FAKE_WORK seconds, then the idle screen.
import os, sys, time, tty, termios, select
LOG = os.environ.get("FAKE_LOG", "/tmp/fake_claude.log")
WORK = float(os.environ.get("FAKE_WORK", "2"))
rule = "─" * 60
def screen(kind, buf=""):
    if kind == "working":
        return f"● Working on it\n\n✻ Thinking… (3s · ↑ 1.2k tokens · esc to interrupt)\n\n{rule}\n❯ \n{rule}\n  ⏵⏵ accept edits on (shift+tab to cycle)\n"
    shown = buf.replace("\n", "⏎")[-50:]
    return f"● Done.\n\n{rule}\n❯ {shown}\n{rule}\n  ? for shortcuts\n"
fd = sys.stdin.fileno(); old = termios.tcgetattr(fd); tty.setraw(fd)
sys.stdout.write("\x1b[?1049h\x1b[?2004h"); sys.stdout.flush()
def draw(k, b=""): sys.stdout.write("\x1b[2J\x1b[H" + screen(k, b).replace("\n", "\r\n")); sys.stdout.flush()
buf = ""; inpaste = False; raw = b""; draw("idle")
try:
    while True:
        r, _, _ = select.select([fd], [], [], 0.1)
        if not r: continue
        data = os.read(fd, 65536)
        if not data: break
        raw += data
        while raw:
            if raw.startswith(b"\x1b[200~"): inpaste = True; raw = raw[6:]; continue
            if raw.startswith(b"\x1b[201~"): inpaste = False; raw = raw[6:]; continue
            if raw[:1] == b"\x03": sys.exit(0)
            lead = raw[0]
            n = 1 if lead < 0x80 else 2 if lead >> 5 == 6 else 3 if lead >> 4 == 14 else 4 if lead >> 3 == 30 else 1
            if len(raw) < n: break          # incomplete UTF-8 sequence, wait for more bytes
            ch = raw[:n].decode("utf8", "replace")
            raw = raw[n:]
            if ch == "\r" and not inpaste:
                with open(LOG, "a") as f: f.write(repr(buf) + "\n")
                buf = ""; draw("working"); time.sleep(WORK); draw("idle")
            else:
                buf += ch if ch != "\r" else "\n"
                draw("idle", buf)
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old); sys.stdout.write("\x1b[?2004l\x1b[?1049l")
